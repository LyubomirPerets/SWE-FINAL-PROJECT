NODE_ENV=development
PORT=3000

# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
# Separate database used by the test suite (created by docker-compose init script)
TEST_DATABASE_URL=postgres://crm:crm@localhost:5432/crm_test

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# S3 file storage (optional: only needed for attachments and `npm run s3:check`).
# Ask Lyubomir for the keys in a private message. Never commit real values.
AWS_REGION=us-east-2
S3_BUCKET=crm-attachments-lp
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
