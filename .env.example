NODE_ENV=development
PORT=3000

# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
# Separate database used by the test suite (created by docker-compose init script)
TEST_DATABASE_URL=postgres://crm:crm@localhost:5432/crm_test

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
